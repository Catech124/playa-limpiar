static func ancho(txt: String, esc: int) -> int:
	if txt.is_empty():
		return 0
	return txt.length() * 6 * esc - esc


static func dibujar(ci: CanvasItem, pos: Vector2, txt: String, esc: int, color: Color) -> void:
	var x := roundi(pos.x)
	var y := roundi(pos.y)
	for i in txt.length():
		var ch := txt[i].to_upper()
		if ch != " ":
			var gl: Array = FUENTE.get(ch, FUENTE["?"])
			for r in 7:
				var fila: String = gl[r]
				for c in 5:
					if fila[c] == "1":
						ci.draw_rect(Rect2(x + c * esc, y + r * esc, esc, esc), color)
		x += 6 * esc


static func centrado(ci: CanvasItem, cx: float, y: float, txt: String, esc: int, color: Color) -> void:
	dibujar(ci, Vector2(cx - ancho(txt, esc) * 0.5, y), txt, esc, color)


## Texto con sombra dura, el truco clásico para que se lea sobre cualquier fondo.
static func dibujar_sombra(ci: CanvasItem, pos: Vector2, txt: String, esc: int,
		color: Color, sombra := Color("161c22")) -> void:
	dibujar(ci, pos + Vector2(esc, esc), txt, esc, sombra)
	dibujar(ci, pos, txt, esc, color)


static func centrado_sombra(ci: CanvasItem, cx: float, y: float, txt: String, esc: int,
		color: Color, sombra := Color("161c22")) -> void:
	centrado(ci, cx + esc, y + esc, txt, esc, sombra)
	centrado(ci, cx, y, txt, esc, color)


## Panel con borde grueso y bisel: la base de toda la UI.
static func panel(ci: CanvasItem, rect: Rect2, relleno: Color, borde: Color,
		grosor := 3, bisel := true) -> void:
	ci.draw_rect(rect, borde)
	var r := Rect2(rect.position + Vector2(grosor, grosor),
		rect.size - Vector2(grosor, grosor) * 2.0)
	ci.draw_rect(r, relleno)
	if bisel:
		ci.draw_rect(Rect2(r.position, Vector2(r.size.x, grosor)), relleno.lightened(0.16))
		ci.draw_rect(Rect2(Vector2(r.position.x, r.end.y - grosor), Vector2(r.size.x, grosor)),
			relleno.darkened(0.16))


static func icono(ci: CanvasItem, pos: Vector2, nombre: String, esc: int, color: Color) -> void:
	var mapa: Array = ICONOS.get(nombre, [])
	for r in mapa.size():
		var fila: String = mapa[r]
		for c in fila.length():
			if fila[c] == "1":
				ci.draw_rect(Rect2(pos.x + c * esc, pos.y + r * esc, esc, esc), color)
